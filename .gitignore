# Build outputs and dependency caches (at every depth)
target/
node_modules/
build/
dist/
coverage/
.dart_tool/
.pub-cache/
.gradle/
.cxx/
__pycache__/
*.py[cod]
*.log
*.tmp
*.swp
.DS_Store
.idea/
.playwright-mcp/
/test-results/

# Local credentials and environment; commit only explicit examples
.env
.env.*
!.env.example
!*.env.example
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
credentials.json
secrets.json
providers.json
key.properties
local.properties
.flutter-plugins*

